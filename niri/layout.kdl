    layout {
	//background-color "transparent"
        gaps 0 // Gap between windows
        center-focused-column "never" // Don’t auto-center focused column

        preset-column-widths {
            proportion 0.33333
            proportion 0.5
            proportion 0.66667
        }

        focus-ring {
            off //ring
            width 3
            active-color "#00ac89"
            inactive-color "#505050"
        }
        border {
            on //border
            width 5
        }

        shadow {

            softness 30
            spread 5
            offset x=0 y=5
            color "#0007"
        }

        struts {}
    }
